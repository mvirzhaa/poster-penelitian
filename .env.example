PORT=3000
DATABASE_URL=postgres://poster:poster@localhost:5432/poster_penelitian
# Alamat publik aplikasi, mis. https://poster.instansi.go.id
# Dipakai untuk QR otomatis, pratinjau saat tautan dibagikan, dan tautan di API/webhook.
PUBLIC_BASE_URL=
# Isi "true" bila aplikasi berjalan di belakang proxy/nginx (agar alamat IP & https terbaca benar)
TRUST_PROXY=
# Opsional: lokasi Chrome/Chromium bila tidak memakai Chrome bawaan Puppeteer
CHROME_PATH=

# Integrasi Journey (direktori dosen UIKA). Isi keduanya agar pembimbing bisa dicari dari database Journey
# dan poster ukuran "share" dikirim ke tab Produk. Kosongkan bila tidak dipakai (pembimbing tetap bisa diketik manual).
# JOURNEY_API_KEY harus sama dengan INTEGRATION_API_KEY di backend Journey.
JOURNEY_API_URL=
JOURNEY_API_KEY=

# Integrasi SSO E-Portal UIKA (admin: https://eportal.uika-bogor.ac.id/admin/app-modules)
# Daftarkan modul dengan URL Callback SSO: https://utility.uika-bogor.ac.id/poster/sso/callback
SSO_BASE_URL=https://eportal.uika-bogor.ac.id
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_APP_MODULE_ID=
EPORTAL_FRONTEND_URL=https://eportal.uika-bogor.ac.id
